#!/usr/bin/env python3
"""Record that a file has been through the terminology-checker.

The stamp is named for the sha256 of the file's bytes, so it stops matching
if the file changes afterwards.
"""

import datetime
import hashlib
import os
import sys

STAMP_DIR = os.path.expanduser("~/.claude/termcheck")

if len(sys.argv) != 2:
    sys.exit("usage: termcheck-stamp <file>")

path = os.path.abspath(os.path.expanduser(os.path.expandvars(sys.argv[1])))
with open(path, "rb") as handle:
    digest = hashlib.sha256(handle.read()).hexdigest()

os.makedirs(STAMP_DIR, exist_ok=True)
with open(os.path.join(STAMP_DIR, digest), "w") as handle:
    handle.write(f"{path}\n{datetime.datetime.now().isoformat(timespec='seconds')}\n")

print(f"stamped {path}")
